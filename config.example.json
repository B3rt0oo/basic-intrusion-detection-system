{
  "input": { "type": "jsonl-stdin", "device": "eth0", "bpf": "tcp or udp" },
  "port_scan": { "enabled": true, "threshold": 10, "window": "60s", "max_per_host": 4096 },
  "conn_rate": { "enabled": true, "threshold": 100, "window": "10s" },
  "dns_anomaly": { "enabled": true, "window": "60s", "unique_subs_per_base_thresh": 50, "long_name_length": 60, "query_rate_per_src_threshold": 200 },
  "alerts": { "stdout": true, "file": "alerts.jsonl", "syslog": false },
  "rules": [
    { "name": "Blocklist host", "severity": "high", "src_ip": "203.0.113.9" },
    { "name": "SSH Access", "severity": "low", "proto": "tcp", "dst_port": 22 },
    { "name": "DNS exfil suspect", "severity": "medium", "dns_qname_regex": "^[A-Za-z0-9]{20,}\\.", "dns_qtype": "A" },
    { "name": "Corp domain access", "severity": "low", "dns_qname_suffix": "corp.example" }
  ]
}
